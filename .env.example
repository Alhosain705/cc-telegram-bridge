# هذا الملف مرجع للمفاتيح فقط. استخدم نافذة START.cmd لإنشاء .env الحقيقي.
# النافذة تشفّر رمز البوت بـDPAPI؛ لا تكتب رمزاً صريحاً هنا.
TELEGRAM_BOT_TOKEN_DPAPI=CREATED_BY_THE_WINDOWS_LAUNCHER

# رقم حساب المالك الوحيد في تيليجرام، أرقام فقط. الإصدار الأول يعمل في المحادثة الخاصة فقط.
TELEGRAM_OWNER_IDS=123456789

# اختياري: إذا وضعته يتحقق البرنامج من اسم البوت، ولا يخرج بصمت عند الخطأ.
TELEGRAM_BOT_USERNAME=

# مجلد عمل كلود. النقطة تعني مجلد البرنامج.
CLAUDE_WORKDIR=.

# اختياري: مسار claude.exe أو cli.js. البرنامج يبحث تلقائياً إذا تركته فارغاً.
CLAUDE_BIN=

# الحدود بالدقائق. غيّرها فقط إذا عرفت أثرها.
CLAUDE_TIMEOUT_MINUTES=45

# اتركه 0 لاستخدام اشتراك كلود. تفعيله يسمح بفوترة API إذا كان المفتاح موجوداً.
CLAUDE_ALLOW_API_BILLING=0
